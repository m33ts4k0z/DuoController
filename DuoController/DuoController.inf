[Version]
Signature="$Windows NT$"
Class=DuoController
ClassGuid={070D9FF9-4F04-4419-90D2-C4CA9DFDB2EE}
Provider=%ManufacturerName%
CatalogFile=DuoController.cat
PnpLockDown=1
DriverVer= 

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...17134

[Standard.NT$ARCH$.10.0...17134]
%ROOT\VID_054C&PID_0DF2.DeviceName%=DuoController_Install_PS, ROOT\VID_054C&PID_0DF2
%ROOT\VID_054C&PID_0CE6.DeviceName%=DuoController_Install_PS, ROOT\VID_054C&PID_0CE6
%ROOT\VID_054C&PID_05C4.DeviceName%=DuoController_Install_PS, ROOT\VID_054C&PID_05C4
%ROOT\VID_045E&PID_02FF&IG_00.DeviceName%=DuoController_Install_Xbox, ROOT\VID_045E&PID_02FF&IG_00
%ROOT\DUOXUSBTEST.DeviceName%=DuoController_Install_Xusb, ROOT\DUOXUSBTEST

[ControlFlags]
ExcludeFromSelect=ROOT\VID_054C&PID_0DF2
ExcludeFromSelect=ROOT\VID_054C&PID_0CE6
ExcludeFromSelect=ROOT\VID_054C&PID_05C4
ExcludeFromSelect=ROOT\VID_045E&PID_02FF&IG_00
ExcludeFromSelect=ROOT\DUOXUSBTEST

[ClassInstall32]
AddReg=DuoControllerClass_RegistryAdd

[DuoControllerClass_RegistryAdd]
HKR,,,,%ClassName%
HKR,,Icon,,"-24"

[SourceDisksFiles]
DuoController.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[DuoController_Install.NT.hw.AddReg]
HKR,,"LowerFilters",0x00010008,"WUDFRd"

; PlayStation (DualSense Edge / DualSense / DualShock 4)
[DuoController_Install_PS]
UmdfLibraryVersion=$UMDFVERSION$ 
ServiceBinary=%13%\DuoController.dll

[DuoController_Install_PS.NT]
CopyFiles=UMDriverCopy

[DuoController_Install_PS.NT.Services]
AddService=WUDFRd,0x000001f8,WUDFRD_ServiceInstall
AddService=mshidumdf, 0x000001fa, mshidumdf.AddService

[DuoController_Install_PS.NT.hw]
AddReg=DuoController_Install.NT.hw.AddReg

[DuoController_Install_PS.NT.Wdf]
UmdfService=DuoController,DuoController_Install_PS
UmdfServiceOrder=DuoController
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2
UmdfHostPriority=PriorityHigh

[DuoController_Install_PS.NT.CoInstallers]
AddReg=CoInstallers_AddReg

; Xbox — real XUSB device (plain UMDF function driver).
; NOT a HID device: no mshidumdf, no xinputhid, no GIP includes. The driver
; registers the XUSB device interface from code and answers the XUSB IOCTL
; protocol, so XInput reads it exactly like real Xbox hardware.
[DuoController_Install_Xbox]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\DuoController.dll

[DuoController_Install_Xbox.NT]
CopyFiles=UMDriverCopy

[DuoController_Install_Xbox.NT.Services]
; 0x1fa (vs 0x1f8) sets SPSVCINST_ASSOCSERVICE: with no HID/mshidumdf service, WUDFRd
; is the device's associated service (required for a UMDF-only function driver).
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

; A pure UMDF function driver must NOT list WUDFRd in LowerFilters: WUDFRd is already
; the devnode's service, and adding it as a lower filter too loads the reflector twice
; on one stack — its second AddDevice fails with STATUS_DEVICE_CONFIGURATION_ERROR
; (0xc0000182) / CM_PROB_FAILED_ADD. (LowerFilters=WUDFRd is only for the HID sections,
; where mshidumdf owns the FDO.) The DelReg heals devnodes created by older packages.
[DuoController_Install_Xbox.NT.hw]
DelReg=DuoController_XusbFunction.NT.hw.DelReg

[DuoController_XusbFunction.NT.hw.DelReg]
HKR,,"LowerFilters"

[DuoController_Install_Xbox.NT.Wdf]
UmdfService=DuoController,DuoController_Install_Xbox
UmdfServiceOrder=DuoController
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2
UmdfHostPriority=PriorityHigh

[DuoController_Install_Xbox.NT.CoInstallers]
AddReg=CoInstallers_AddReg

; ============ XUSB spike test device (plain UMDF function driver) ============
; Not a HID device: no mshidumdf, no xinputhid. It registers the XUSB device
; interface from code and answers the XUSB IOCTL protocol. Materialise with:
;   devgen /add /instanceid DUOXUSB0 /hardwareid "ROOT\DUOXUSBTEST"
[DuoController_Install_Xusb]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\DuoController.dll

[DuoController_Install_Xusb.NT]
CopyFiles=UMDriverCopy

[DuoController_Install_Xusb.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

; Same as the Xbox section: no WUDFRd lower filter on a WUDFRd-serviced devnode.
[DuoController_Install_Xusb.NT.hw]
DelReg=DuoController_XusbFunction.NT.hw.DelReg

[DuoController_Install_Xusb.NT.Wdf]
UmdfService=DuoController,DuoController_Install_Xusb
UmdfServiceOrder=DuoController
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2
UmdfHostPriority=PriorityHigh

[DuoController_Install_Xusb.NT.CoInstallers]
AddReg=CoInstallers_AddReg

[WUDFRD_ServiceInstall]
DisplayName = %WudfRdDisplayName%
ServiceType = 1
StartType = 3
ErrorControl = 1
; WUDFRd.sys is an inbox binary in %12% (System32\drivers), NOT copied into the
; driver-store package (%13%). Referencing %13% makes AddService fail with
; "binary not present" (0xE0000217) — fatal once WUDFRd is the associated service.
ServiceBinary = %12%\WUDFRd.sys

[mshidumdf.AddService]
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\mshidumdf.sys  ; inbox binary, same fix as WUDFRd above

[CoInstallers_AddReg]
HKR,,CoInstallers32,0x00010000,"WUDFCoinstaller.dll"

[DestinationDirs]
UMDriverCopy=13

[UMDriverCopy]
DuoController.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="Black-Seraph"
ClassName="DuoController Devices"
DiskName = "DuoController Installation Disk"
WudfRdDisplayName="DuoController User-mode Driver"
ROOT\VID_054C&PID_0DF2.DeviceName="DualSense Edge Wireless Controller"
ROOT\VID_054C&PID_0CE6.DeviceName="DualSense Wireless Controller"
ROOT\VID_054C&PID_05C4.DeviceName="DualShock 4 Wireless Controller"
ROOT\VID_045E&PID_02FF&IG_00.DeviceName="Xbox One Elite Wireless Controller"
ROOT\DUOXUSBTEST.DeviceName="DuoController XUSB Spike Test Device"